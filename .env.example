# PostgreSQL (auth-service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=memo
POSTGRES_PASSWORD=memo1234
POSTGRES_DB=memo_auth

# MongoDB (memo-service)
MONGO_URI=mongodb://memo:memo1234@localhost:27017/memo_db?authSource=admin

# Redis (ai-service)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=1h

# Claude API
ANTHROPIC_API_KEY=your-api-key-here

# App
PORT=3000
NODE_ENV=development
